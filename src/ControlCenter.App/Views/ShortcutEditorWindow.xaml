<Window x:Class="ControlCenter.App.Views.ShortcutEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="编辑常用入口" Width="480" Height="540" MinHeight="380" WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Microsoft YaHei UI" FontSize="13">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
<TextBlock Text="名称"/><TextBox x:Name="LabelBox" Margin="0,4,0,10" MaxLength="80" AutomationProperties.Name="入口名称"/>
<TextBlock Text="类型"/><ComboBox x:Name="KindBox" SelectedIndex="0" Margin="0,4,0,10" MinHeight="32" AutomationProperties.Name="入口类型"><ComboBoxItem Tag="folder">本机目录</ComboBoxItem><ComboBoxItem Tag="application">程序</ComboBoxItem><ComboBoxItem Tag="url">网页</ComboBoxItem></ComboBox>
<TextBlock Text="目标"/><DockPanel Margin="0,4,0,10"><Button DockPanel.Dock="Right" Content="选择…" Click="Browse_Click" Margin="6,0,0,0"/><TextBox x:Name="TargetBox" AutomationProperties.Name="入口目标"/></DockPanel>
<TextBlock Text="程序参数（每行一个，保留行内空格）"/><TextBox x:Name="ArgumentsBox" AcceptsReturn="True" Height="80" VerticalScrollBarVisibility="Auto" Margin="0,4,0,10" AutomationProperties.Name="程序参数"/>
<TextBlock Text="程序工作目录（可留空）"/><TextBox x:Name="WorkingBox" Margin="0,4,0,10" AutomationProperties.Name="程序工作目录"/>
<TextBlock x:Name="ErrorText" TextWrapping="Wrap" Style="{StaticResource Secondary}" Margin="0,6,0,12"/>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" IsCancel="True" Margin="0,0,8,0"/><Button Content="加入设置草稿" Click="Save_Click"/></StackPanel>
</StackPanel></ScrollViewer></Window>

