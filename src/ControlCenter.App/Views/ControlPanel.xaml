<Window x:Class="ControlCenter.App.Views.ControlPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="个人控制中心 · 第四轮候选" Width="360" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True">
<Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></Window.Resources>
<Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="15">
<Grid x:Name="ContentRoot" RenderTransformOrigin="0.5,1"><Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Margin="0,0,0,14">
<DockPanel><Button x:Name="ExitButton" DockPanel.Dock="Right" Content="退出" Click="Exit_Click" Visibility="Collapsed" Margin="6,0,0,0" Padding="8,3"/><Button DockPanel.Dock="Right" x:Name="SettingsButton" Content="设置" Click="Settings_Click" AutomationProperties.AutomationId="Settings" AutomationProperties.Name="打开设置" Padding="10,3"/><TextBlock Text="个人控制中心" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
<DockPanel Margin="0,8,0,0"><Button DockPanel.Dock="Right" Content="刷新" Command="{Binding Refresh}" Padding="8,2" MinHeight="26"/><TextBlock Text="{Binding DataOriginLabel}" Style="{StaticResource Secondary}" VerticalAlignment="Center"/></DockPanel>
</StackPanel>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
<StackPanel x:Name="ModuleHost">
<Border x:Name="AudioCard" Style="{StaticResource Card}"><StackPanel>
<DockPanel Margin="0,0,0,10"><Button x:Name="DeviceButton" DockPanel.Dock="Right" Command="{Binding ToggleDevices}" BorderThickness="0" Padding="8,0" MaxWidth="215" AutomationProperties.Name="查看输出设备"><TextBlock Text="{Binding Device}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Device}"/></Button><TextBlock Text="声音" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
<Button Content="{Binding MuteLabel}" Command="{Binding Mute}" Padding="8,4" AutomationProperties.AutomationId="Mute"/>
<Slider x:Name="VolumeSlider" Grid.Column="1" Margin="10,0" Minimum="0" Maximum="100" Value="{Binding Volume, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding AudioAvailable}" VerticalAlignment="Center" IsMoveToPointEnabled="True" AutomationProperties.Name="系统音量" AutomationProperties.AutomationId="Volume" PreviewMouseLeftButtonDown="Volume_Begin" PreviewMouseLeftButtonUp="Volume_End" LostMouseCapture="Volume_LostCapture"/>
<TextBlock Grid.Column="2" Text="{Binding VolumeLabel}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
</Grid>
<TextBlock Text="{Binding AudioStatus}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
<StackPanel x:Name="DeviceList" Visibility="{Binding DevicesOpen, Converter={StaticResource BoolVisibility}}" Margin="0,10,0,0" IsVisibleChanged="DeviceList_VisibleChanged">
<ItemsControl ItemsSource="{Binding Devices}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<Button Content="在系统设置中切换输出" Command="{Binding SoundSettings}" Margin="0,8,0,0"/>
<TextBlock Text="{Binding AudioSwitchExplanation}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
</StackPanel></StackPanel></Border>
<Border x:Name="PowerCard" Style="{StaticResource Card}"><StackPanel>
<DockPanel Margin="0,0,0,10"><TextBlock DockPanel.Dock="Right" Text="{Binding PowerSource}" Style="{StaticResource Secondary}"/><TextBlock Text="电源" FontWeight="SemiBold"/></DockPanel>
<ItemsControl ItemsSource="{Binding PowerChoices}"><ItemsControl.ItemTemplate><DataTemplate>
<Button Content="{Binding Label}" Command="{Binding DataContext.SelectPower, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" Margin="0,0,0,6" HorizontalContentAlignment="Left"/>
</DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<TextBlock Text="{Binding PowerStatus}" Style="{StaticResource Secondary}" TextWrapping="Wrap"/>
<TextBlock Text="切换整个方案，可能影响亮度和睡眠设置。" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
</StackPanel></Border>
<Border x:Name="AwakeCard" Style="{StaticResource Card}"><StackPanel DataContext="{Binding Session}">
<TextBlock Text="保持唤醒" FontWeight="SemiBold"/>
<TextBlock Text="{Binding AwakeText}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,6"/>
<WrapPanel><Button Content="30 分钟" Command="{Binding Start}" CommandParameter="30" Margin="0,0,6,6"/><Button Content="1 小时" Command="{Binding Start}" CommandParameter="60" Margin="0,0,6,6"/><Button Content="结束" Command="{Binding Stop}" Margin="0,0,0,6"/></WrapPanel>
<StackPanel Orientation="Horizontal"><TextBox Text="{Binding Minutes, UpdateSourceTrigger=PropertyChanged}" Width="55" MaxLength="3" VerticalContentAlignment="Center" AutomationProperties.Name="保持唤醒分钟数"/><TextBlock Text="分钟" Margin="6,0" VerticalAlignment="Center"/><Button Content="自定义开始" Command="{Binding Start}"/></StackPanel>
<CheckBox Content="本次同时保持屏幕常亮" IsChecked="{Binding KeepDisplay}" Margin="0,8,0,4"/>
<TextBlock Text="不阻止主动睡眠或合盖；不清除其他应用的请求。" Style="{StaticResource Secondary}" TextWrapping="Wrap"/>
<TextBlock Text="{Binding AwakeMessage}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
</StackPanel></Border>
<Border x:Name="ProxyCard" Style="{StaticResource Card}"><StackPanel DataContext="{Binding Session}">
<DockPanel><Button DockPanel.Dock="Right" Content="打开代理" Command="{Binding OpenProxy}" Padding="8,2"/><TextBlock Text="代理" FontWeight="SemiBold"/></DockPanel>
<TextBlock Text="{Binding LocalText}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,6"/>
<TextBlock Text="{Binding TargetText}" Style="{StaticResource Secondary}" TextWrapping="Wrap"/>
<Button Content="测试指定目标（5 秒）" Command="{Binding TestProxy}" Margin="0,8,0,4"/>
<TextBlock Text="{Binding RemoteText}" Style="{StaticResource Secondary}" TextWrapping="Wrap"/>
<TextBlock Text="{Binding ProxyLaunchMessage}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
</StackPanel></Border>
<StackPanel x:Name="ShortcutsCard"><ItemsControl ItemsSource="{Binding Shortcuts}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
<Button Content="{Binding Label}" Command="{Binding DataContext.Launch, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,0,6,6" MaxWidth="290"/>
</DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<Button Content="管理常用入口" Command="{Binding EditShortcuts}" Margin="0,4,0,0"/></StackPanel>
</StackPanel></ScrollViewer>
<TextBlock Grid.Row="2" Text="{Binding Notice}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="2,12,2,0" AutomationProperties.LiveSetting="Polite"/>
</Grid></Border></Window>
