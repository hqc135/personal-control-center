<Window x:Class="ControlCenter.App.Views.ControlPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:local="clr-namespace:ControlCenter.App.Views"
Title="个人控制中心" Width="460" Height="720" MinWidth="340" MinHeight="360" SizeToContent="Manual" WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False" Topmost="True"
Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True">
<shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="58" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
<Window.Resources>
<BooleanToVisibilityConverter x:Key="BoolVisibility"/>
<Style TargetType="ScrollBar"><Setter Property="Width" Value="10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb MinHeight="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Margin="3,0,1,0" Background="{DynamicResource BorderBrush}" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="CornerRadius" Value="{DynamicResource CardRadius}"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="{DynamicResource CardPadding}"/></Style>
<Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,4"/></Style>
<Style x:Key="Glyph" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/><Setter Property="FontSize" Value="18"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
<Style x:Key="Feedback" TargetType="TextBlock" BasedOn="{StaticResource Secondary}"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,6,0,0"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="Text" Value="已读取系统状态"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
<Style TargetType="Expander">
<Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/><Setter Property="Margin" Value="0,8,0,0"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel>
<ToggleButton x:Name="HeaderToggle" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalContentAlignment="Left" MinHeight="28" Cursor="Hand" AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}">
<ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="HeaderBorder" Background="Transparent" CornerRadius="6" Padding="2,4" BorderThickness="1" BorderBrush="Transparent"><DockPanel><TextBlock x:Name="Chevron" Text="›" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,8,0"/><ContentPresenter VerticalAlignment="Center"/></DockPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="⌄"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
<TextBlock Text="{TemplateBinding Header}" Style="{StaticResource Secondary}"/>
</ToggleButton><ContentPresenter x:Name="Details" Visibility="Collapsed"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Details" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
</Style>
</Window.Resources>
<Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16">
<Grid x:Name="ContentRoot"><Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="2,0,2,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="控制中心" FontSize="21" FontWeight="SemiBold" ToolTip="拖动标题移动窗口；边缘可调整大小"/><TextBlock Text="{Binding DataOriginLabel}" Style="{StaticResource Secondary}" Margin="0,4,0,0"/></StackPanel>
<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
<Button x:Name="ExitButton" Content="退出" Click="Exit_Click" Visibility="Collapsed" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource QuietButton}"/>
<Button Command="{Binding Refresh}" ToolTip="刷新状态" AutomationProperties.Name="刷新状态" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource QuietButton}"><TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="16"/></Button>
<Button x:Name="PinButton" Content="固定" Click="Pin_Click" ToolTip="切换到其他窗口时保持面板打开" AutomationProperties.Name="固定或取消固定面板" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource QuietButton}"/>
<Button x:Name="SettingsButton" Click="Settings_Click" ToolTip="设置" AutomationProperties.AutomationId="Settings" AutomationProperties.Name="打开设置" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource QuietButton}"><TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" FontSize="16"/></Button>
</StackPanel></Grid>
<DockPanel Grid.Row="1" Margin="0,0,0,12">
<Button DockPanel.Dock="Right" Content="编辑收藏" Click="Favorites_Click" Style="{StaticResource QuietButton}"/>
<StackPanel Orientation="Horizontal"><Button x:Name="HomeTab" Content="收藏" Click="Home_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0"/><Button x:Name="AllTab" Content="全部功能" Click="All_Click"/></StackPanel>
</DockPanel>
<ScrollViewer x:Name="PanelScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,2,0">
<local:ControlCardPanel x:Name="ModuleHost">
<Border x:Name="AudioCard" Style="{StaticResource Tile}"><StackPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel Orientation="Horizontal"><TextBlock Text="&#xE767;" Style="{StaticResource Glyph}" Margin="0,0,10,0"/><TextBlock Text="声音" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
<Button x:Name="DeviceButton" Grid.Column="1" Command="{Binding ToggleDevices}" Style="{StaticResource QuietButton}" AutomationProperties.Name="展开输出设备" Content="设备 ›"/>
</Grid>
<TextBlock Text="{Binding Device}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Device}" Margin="0,2,0,8"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
<Button Content="{Binding MuteLabel}" Command="{Binding Mute}" Style="{StaticResource QuietButton}" AutomationProperties.AutomationId="Mute"/>
<Slider x:Name="VolumeSlider" Grid.Column="1" Margin="6,0,10,0" Minimum="0" Maximum="100" Value="{Binding Volume, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding AudioAvailable}" VerticalAlignment="Center" IsMoveToPointEnabled="True" AutomationProperties.Name="系统音量" AutomationProperties.AutomationId="Volume" PreviewMouseLeftButtonDown="Volume_Begin" PreviewMouseLeftButtonUp="Volume_End" LostMouseCapture="Volume_LostCapture"/>
<TextBlock Grid.Column="2" Text="{Binding VolumeLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"/>
</Grid><TextBlock Text="{Binding AudioStatus}" Style="{StaticResource Feedback}"/>
<StackPanel x:Name="DeviceList" Visibility="{Binding DevicesOpen, Converter={StaticResource BoolVisibility}}" Margin="0,10,0,0" IsVisibleChanged="DeviceList_VisibleChanged">
<StackPanel Visibility="{Binding HasMultipleOutputs, Converter={StaticResource BoolVisibility}}"><ComboBox x:Name="OutputPicker" ItemsSource="{Binding OutputDevices}" DisplayMemberPath="Name" AutomationProperties.Name="选择输出设备"/><Button Content="切换到所选输出" Click="Output_Click" Margin="0,6,0,0"/></StackPanel><TextBlock Text="{Binding OutputHint}" Style="{StaticResource Feedback}"/>
<Expander Header="设备详情"><StackPanel><TextBlock Text="切换媒体与系统默认输出；通话默认设备保持不变。" Style="{StaticResource Feedback}"/><ItemsControl ItemsSource="{Binding Devices}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<Button Content="在系统设置中切换输出" Command="{Binding SoundSettings}" Margin="0,8,0,0"/><TextBlock Text="{Binding AudioSwitchExplanation}" Style="{StaticResource Feedback}"/></StackPanel></Expander>
</StackPanel></StackPanel></Border>
<Border x:Name="PowerCard" Tag="Compact" Style="{StaticResource Tile}"><StackPanel>
<Border Background="{DynamicResource AccentSurfaceBrush}" CornerRadius="16" Width="34" Height="34" HorizontalAlignment="Left"><TextBlock Text="&#xE7E8;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
<TextBlock Text="电源" FontWeight="SemiBold" Margin="0,10,0,4"/>
<TextBlock Text="{Binding ActivePowerName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ActivePowerName}"/>
<TextBlock Text="{Binding PowerSource}" Style="{StaticResource Secondary}" Margin="0,4,0,0"/>
<TextBlock Text="{Binding PowerStatus}" Style="{StaticResource Feedback}"/>
<Expander Header="方案与设置"><StackPanel Margin="0,8,0,0">
<ItemsControl ItemsSource="{Binding PowerChoices}" Visibility="{Binding HasMultiplePowerSchemes, Converter={StaticResource BoolVisibility}}"><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.SelectPower, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" Margin="0,0,0,6"><TextBlock Text="{Binding Label}" TextWrapping="Wrap"/></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<Button Content="系统电源设置" Command="{Binding PowerSettings}" Padding="6,4"/><TextBlock Text="{Binding PowerHint}" Style="{StaticResource Feedback}"/>
</StackPanel></Expander></StackPanel></Border>
<Border x:Name="AwakeCard" Tag="Compact" Style="{StaticResource Tile}"><StackPanel DataContext="{Binding Session}">
<Border CornerRadius="16" Width="34" Height="34" HorizontalAlignment="Left"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource HoverBrush}"/><Style.Triggers><DataTrigger Binding="{Binding AwakeActive}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="&#xE708;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
<TextBlock Text="保持唤醒" FontWeight="SemiBold" Margin="0,10,0,4"/>
<TextBlock Text="{Binding AwakeSummary}" Style="{StaticResource Secondary}" TextWrapping="Wrap"/>
<WrapPanel Margin="0,8,0,0"><Button Content="30 分钟" Command="{Binding Start}" CommandParameter="30" Padding="8,4" Margin="0,0,4,4" Style="{StaticResource PrimaryButton}"/><Button Content="结束" Command="{Binding Stop}" Padding="8,4" Margin="0,0,0,4"/></WrapPanel>
<TextBlock Text="{Binding AwakeMessage}" Style="{StaticResource Feedback}"/>
<Expander Header="时长与选项"><StackPanel Margin="0,8,0,0">
<Button Content="保持 1 小时" Command="{Binding Start}" CommandParameter="60"/>
<WrapPanel Margin="0,8"><TextBox Text="{Binding Minutes, UpdateSourceTrigger=PropertyChanged}" Width="48" MaxLength="3" AutomationProperties.Name="保持唤醒分钟数"/><Button Content="开始" ToolTip="按输入的分钟数开始" Command="{Binding Start}" Margin="6,0,0,0" Padding="8,4"/></WrapPanel>
<CheckBox IsChecked="{Binding KeepDisplay}"><TextBlock Text="同时保持屏幕常亮" TextWrapping="Wrap"/></CheckBox>
<TextBlock Text="不阻止主动睡眠或合盖；不清除其他应用的请求。" Style="{StaticResource Feedback}"/>
</StackPanel></Expander></StackPanel></Border>
<Border x:Name="ProxyCard" Tag="Compact" Style="{StaticResource Tile}"><StackPanel DataContext="{Binding Session}">
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<Border Background="{DynamicResource AccentSurfaceBrush}" CornerRadius="16" Width="34" Height="34" HorizontalAlignment="Left" Margin="0,0,10,0"><TextBlock Text="&#xE774;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
<Button Grid.Column="1" Content="打开" Command="{Binding OpenProxy}" ToolTip="打开已绑定的代理程序" Style="{StaticResource QuietButton}"/>
</Grid><TextBlock Text="代理连接" FontWeight="SemiBold" Margin="0,10,0,4"/><TextBlock Text="{Binding ProxySummary}" Style="{StaticResource Secondary}" TextWrapping="Wrap"/><TextBlock Text="{Binding ProxyLaunchMessage}" Style="{StaticResource Feedback}"/>
<Expander Header="连接详情与测试"><StackPanel Margin="0,6,0,0"><TextBlock Text="{Binding ProxyAddress}"/><TextBlock Text="{Binding LocalText}" Style="{StaticResource Feedback}"/><TextBlock Text="{Binding TargetText}" Style="{StaticResource Feedback}"/><Button Content="测试指定目标 · 5 秒" Command="{Binding TestProxy}" Margin="0,8,0,0"/><TextBlock Text="{Binding RemoteText}" Style="{StaticResource Feedback}"/></StackPanel></Expander>
</StackPanel></Border>
<Border x:Name="ShortcutsCard" Tag="Compact" Style="{StaticResource Tile}"><StackPanel>
<DockPanel Margin="0,0,0,6"><Button DockPanel.Dock="Right" Content="编辑" Command="{Binding EditShortcuts}" Style="{StaticResource QuietButton}"/><TextBlock Text="常用入口" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
<TextBlock Text="搜索入口" Style="{StaticResource Secondary}" Margin="0,0,0,4"/><TextBox x:Name="ShortcutSearch" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索入口；方向键选择，Enter 打开，Esc 清空" AutomationProperties.Name="搜索常用入口" PreviewKeyDown="ShortcutSearch_KeyDown" Margin="0,0,0,6"/>
<ListBox x:Name="SearchResults" ItemsSource="{Binding FilteredShortcuts}" DisplayMemberPath="Label" SelectedIndex="0" MaxHeight="112" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" PreviewKeyDown="ShortcutResults_KeyDown" MouseDoubleClick="ShortcutResults_DoubleClick"/>
<Button Content="打开所选" IsEnabled="{Binding HasItems, ElementName=SearchResults}" Click="OpenShortcut_Click" Style="{StaticResource QuietButton}"/>

<TextBlock Text="添加常用应用、文件夹或网页"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Shortcuts.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
</StackPanel></Border>
<Border x:Name="BatteryCard" Tag="Compact" Style="{StaticResource Tile}"><StackPanel><TextBlock Text="电池" FontWeight="SemiBold"/><TextBlock Text="{Binding Desktop.Battery}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
<Border x:Name="MicrophoneCard" Tag="Compact" Style="{StaticResource Tile}"><StackPanel><TextBlock Text="麦克风" FontWeight="SemiBold"/><TextBlock Text="{Binding Desktop.MicrophoneSummary}" Style="{StaticResource Secondary}" Margin="0,8,0,0"/><TextBlock Text="{Binding Desktop.MicrophoneName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Desktop.MicrophoneName}" Style="{StaticResource Secondary}" Margin="0,4,0,0"/><Button Content="{Binding Desktop.MicrophoneAction}" Command="{Binding Desktop.MuteMicrophone}" Margin="0,10,0,0"/><Expander Header="输入设置"><Button Content="麦克风权限" Command="{Binding Desktop.OpenSettings}" CommandParameter="麦克风权限" Style="{StaticResource QuietButton}"/></Expander></StackPanel></Border>
<Border x:Name="BrightnessCard" Style="{StaticResource Tile}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="显示设置" Command="{Binding Desktop.OpenSettings}" CommandParameter="显示" Style="{StaticResource QuietButton}"/><TextBlock Text="显示亮度" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><ItemsControl ItemsSource="{Binding Desktop.Displays}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,8"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><DockPanel><Button DockPanel.Dock="Right" Content="应用" Click="Brightness_Click" Tag="{Binding Id}"/><TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=BrightnessSlider, StringFormat={}{0:0}%}" MinWidth="42" Margin="8,0" VerticalAlignment="Center" TextAlignment="Right"/><Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneTime}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTip="松开后点击应用，才会调整真实亮度" AutomationProperties.Name="显示屏亮度"/></DockPanel></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding Desktop.BrightnessHint}" Style="{StaticResource Feedback}"/></StackPanel></Border>
<Border x:Name="MediaCard" Style="{StaticResource Tile}"><StackPanel><TextBlock Text="正在播放" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding Desktop.Media}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,8"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Artist}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Artist}" Style="{StaticResource Secondary}"/><TextBlock Text="{Binding StateLabel}" Style="{StaticResource Secondary}"/><Expander Header="播放器详情"><TextBlock Text="{Binding Id}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Id}"/></Expander><WrapPanel Margin="0,6,0,0"><Button Content="上一首" Tag="previous" IsEnabled="{Binding CanPrevious}" Click="Media_Click"/><Button Content="播放 / 暂停" Tag="toggle" IsEnabled="{Binding CanToggle}" Click="Media_Click" Margin="4,0"/><Button Content="下一首" Tag="next" IsEnabled="{Binding CanNext}" Click="Media_Click"/></WrapPanel></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
<Border x:Name="ConnectionsCard" Style="{StaticResource Tile}"><StackPanel><TextBlock Text="网络与蓝牙" FontWeight="SemiBold"/><TextBlock Text="{Binding Desktop.NetworkSummary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Desktop.NetworkSummary}" Margin="0,8,0,0"/><TextBlock Text="{Binding Desktop.BluetoothSummary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Desktop.BluetoothSummary}" Style="{StaticResource Secondary}" Margin="0,4,0,0"/><Expander Header="连接详情"><TextBlock Text="{Binding Desktop.Connections}" Style="{StaticResource Feedback}"/></Expander><WrapPanel Margin="0,8,0,0"><Button Content="网络设置" Command="{Binding Desktop.OpenSettings}" CommandParameter="网络"/><Button Content="蓝牙设置" Command="{Binding Desktop.OpenSettings}" CommandParameter="蓝牙" Margin="6,0,0,0"/></WrapPanel></StackPanel></Border>
<Border x:Name="ToolsCard" Style="{StaticResource Tile}"><StackPanel><TextBlock Text="快捷设置与工具" FontWeight="SemiBold"/><WrapPanel Margin="0,10,0,0"><Button Content="显示" Command="{Binding Desktop.OpenSettings}" CommandParameter="显示" Margin="0,0,6,6"/><Button Content="混音器" Command="{Binding Desktop.OpenSettings}" CommandParameter="混音器" Margin="0,0,6,6"/><Button Content="存储" Command="{Binding Desktop.OpenSettings}" CommandParameter="存储" Margin="0,0,6,6"/><Button Content="场景" Click="Scenes_Click" Margin="0,0,6,6"/><Button Content="更新与回退" Click="Updates_Click" Margin="0,0,6,6"/><Button Content="重置窗口位置" Click="ResetGeometry_Click" Margin="0,0,6,6"/></WrapPanel><TextBlock Text="{Binding Desktop.Status}" Style="{StaticResource Feedback}"/><Button Content="刷新设备状态" Command="{Binding Desktop.Refresh}" Margin="0,8,0,0"/></StackPanel></Border>
</local:ControlCardPanel></ScrollViewer>
<TextBlock Grid.Row="3" Text="{Binding Notice}" Style="{StaticResource Feedback}" Margin="2,10,20,0" AutomationProperties.LiveSetting="Polite"/>
<ResizeGrip Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="14" Height="14" shell:WindowChrome.ResizeGripDirection="BottomRight" ToolTip="拖动调整窗口大小"/>
</Grid></Border></Window>
